{
  "name": "ashiato",
  "version": "0.1.0",
  "description": "Record which rows your app inserts, updates and deletes — with read-only database access.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishibashi0112/ashiato.git",
    "directory": "packages/ashiato"
  },
  "keywords": [
    "database",
    "diff",
    "testing",
    "sql-server",
    "oracle",
    "postgres",
    "mysql",
    "sqlite",
    "vite-plugin",
    "webview2"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "ashiato": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "mssql": ">=11",
    "mysql2": ">=3",
    "oracledb": ">=6",
    "pg": ">=8",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "happy-dom": "^20.14.6",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "playwright-core": "1.56.1",
    "rrweb": "2.1.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
